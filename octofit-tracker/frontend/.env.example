# Vite environment variables
# Local development API base URL (backend running on port 8000)
VITE_API_BASE="http://localhost:8000"

# Codespaces preview (replace CODESPACE_NAME with your codespace name)
# Example: https://my-codespace-8000.app.github.dev
# Also accepted literal example (CI-friendly): https://my-codespace-8000.app.github.dev
# VITE_API_BASE="https://$CODESPACE_NAME-8000.app.github.dev"
# Example request endpoints:
# https://$CODESPACE_NAME-8000.app.github.dev/api/users
# https://$CODESPACE_NAME-8000.app.github.dev/api/activities
# https://$CODESPACE_NAME-8000.app.github.dev/api/leaderboard
# https://$CODESPACE_NAME-8000.app.github.dev/api/teams
# https://$CODESPACE_NAME-8000.app.github.dev/api/workouts
